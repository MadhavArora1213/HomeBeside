model Coupon {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique @db.VarChar(50)
  discountType     String    @db.VarChar(30) @map("discount_type")
  discountValue    Decimal   @db.Decimal(12, 2) @map("discount_value")
  minimumAmount    Decimal?  @db.Decimal(12, 2) @map("minimum_amount")
  maximumDiscount  Decimal?  @db.Decimal(12, 2) @map("maximum_discount")
  usageLimit       Int?      @map("usage_limit")
  perUserLimit     Int?      @map("per_user_limit")
  startsAt         DateTime  @db.Timestamptz(3) @map("starts_at")
  expiresAt        DateTime  @db.Timestamptz(3) @map("expires_at")
  isActive         Boolean   @map("is_active")
  createdAt        DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId       String   @db.Uuid @map("coupon_id")
  userId         String   @db.Uuid @map("user_id")
  bookingId      String   @db.Uuid @map("booking_id")
  discountAmount Decimal  @db.Decimal(12, 2) @map("discount_amount")
  createdAt      DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("coupon_redemptions")
}

model Referral {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerUserId String    @db.Uuid @map("referrer_user_id")
  referredUserId String?   @db.Uuid @map("referred_user_id")
  referralCode   String    @db.VarChar(50) @map("referral_code")
  status         String    @db.VarChar(30)
  rewardAmount   Decimal   @default(0) @db.Decimal(12, 2) @map("reward_amount")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  completedAt    DateTime? @db.Timestamptz(3) @map("completed_at")

  referrerUser User  @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referredUser User? @relation("ReferralReferred", fields: [referredUserId], references: [id])

  @@map("referrals")
}

model OpsNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType   String   @db.VarChar(50) @map("entity_type")
  entityId     String   @db.Uuid @map("entity_id")
  authorUserId String   @db.Uuid @map("author_user_id")
  note         String   @db.Text
  isPrivate    Boolean  @default(true) @map("is_private")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  authorUser User @relation(fields: [authorUserId], references: [id])

  @@map("ops_notes")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?   @db.Uuid @map("actor_user_id")
  action      String    @db.VarChar(100)
  entityType  String    @db.VarChar(50) @map("entity_type")
  entityId    String?   @db.Uuid @map("entity_id")
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   Unsupported("inet")? @map("ip_address")
  userAgent   String?   @db.Text @map("user_agent")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

model EventOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @db.VarChar(100) @map("event_type")
  aggregateType String    @db.VarChar(50) @map("aggregate_type")
  aggregateId   String    @db.Uuid @map("aggregate_id")
  payload       Json
  status        String    @db.VarChar(30)
  attempts      Int       @default(0)
  availableAt   DateTime  @db.Timestamptz(3) @map("available_at")
  processedAt   DateTime? @db.Timestamptz(3) @map("processed_at")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  @@map("event_outbox")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(255)
  userId         String?  @db.Uuid @map("user_id")
  requestHash    String   @db.Text @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @db.Timestamptz(3) @map("expires_at")
  createdAt      DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@map("idempotency_keys")
}
