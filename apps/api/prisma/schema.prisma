generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid        String?   @unique @db.VarChar(128) @map("firebase_uid")
  phone              String    @unique @db.VarChar(20)
  email              String?   @unique @db.VarChar(255)
  passwordHash       String?   @db.Text @map("password_hash")
  firstName          String    @db.VarChar(100) @map("first_name")
  lastName           String    @db.VarChar(100) @map("last_name")
  profilePhotoUrl    String?   @db.Text @map("profile_photo_url")
  countryId          String    @db.Uuid @map("country_id")
  cityId             String    @db.Uuid @map("city_id")
  preferredLanguage  String    @default("en") @db.VarChar(10) @map("preferred_language")
  timezone           String    @db.VarChar(50)
  currency           String    @db.Char(3)
  status             String    @db.VarChar(30)
  phoneVerifiedAt    DateTime? @db.Timestamptz(3) @map("phone_verified_at")
  emailVerifiedAt    DateTime? @db.Timestamptz(3) @map("email_verified_at")
  lastLoginAt        DateTime? @db.Timestamptz(3) @map("last_login_at")
  createdAt          DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  deletedAt          DateTime? @db.Timestamptz(3) @map("deleted_at")

  country                    Country                  @relation(fields: [countryId], references: [id])
  city                       City                     @relation(fields: [cityId], references: [id])
  sessions                   UserSession[]
  consents                   UserConsent[]
  devices                    UserDevice[]
  userRoles                  UserRole[]
  families                   Family[]
  familyMembers              FamilyMember[]
  familyInvitationsSent      FamilyInvitation[]
  beneficiaryConsentsGiven   BeneficiaryConsent[]
  helper                     Helper?
  bookings                   Booking[]
  incidentsReported          Incident[]
  supportTickets             SupportTicket[]
  communicationPreference    CommunicationPreference?
  whatsappContacts           WhatsappContact[]
  voiceContacts              VoiceContact[]
  callbackRequests           CallbackRequest[]
  ratingsGiven               Rating[]
  helperBlocks               HelperBlock[]
  preferredHelpers           PreferredHelper[]
  couponRedemptions          CouponRedemption[]
  referralsReferrer          Referral[]               @relation("ReferralReferrer")
  referralsReferred          Referral[]               @relation("ReferralReferred")
  opsNotes                   OpsNote[]
  auditLogs                  AuditLog[]
  notifications              Notification[]

  @@map("users")
}

model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid @map("user_id")
  refreshTokenHash  String    @db.Text @map("refresh_token_hash")
  deviceId          String?   @db.Uuid @map("device_id")
  ipAddress         Unsupported("inet")? @map("ip_address")
  userAgent         String?   @db.Text @map("user_agent")
  expiresAt         DateTime  @db.Timestamptz(3) @map("expires_at")
  revokedAt         DateTime? @db.Timestamptz(3) @map("revoked_at")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model UserConsent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  consentType String    @db.VarChar(50) @map("consent_type")
  version     String    @db.VarChar(30)
  accepted    Boolean
  acceptedAt  DateTime  @db.Timestamptz(3) @map("accepted_at")
  revokedAt   DateTime? @db.Timestamptz(3) @map("revoked_at")
  ipAddress   Unsupported("inet")? @map("ip_address")
  metadata    Json

  user User @relation(fields: [userId], references: [id])

  @@map("user_consents")
}

model UserDevice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid @map("user_id")
  deviceId     String    @db.VarChar(100) @map("device_id")
  platform     String    @db.VarChar(20)
  pushToken    String?   @db.Text @map("push_token")
  deviceName   String?   @db.VarChar(150) @map("device_name")
  osVersion    String?   @db.VarChar(50) @map("os_version")
  lastActiveAt DateTime? @db.Timestamptz(3) @map("last_active_at")
  revokedAt    DateTime? @db.Timestamptz(3) @map("revoked_at")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Family {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  ownerUserId String   @db.Uuid @map("owner_user_id")
  status      String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  ownerUser    User                @relation(fields: [ownerUserId], references: [id])
  members      FamilyMember[]
  invitations  FamilyInvitation[]
  beneficiaries Beneficiary[]
  bookings     Booking[]

  @@map("families")
}

model FamilyMember {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String   @db.Uuid @map("family_id")
  userId          String   @db.Uuid @map("user_id")
  role            String   @db.VarChar(30)
  canBook         Boolean  @default(false) @map("can_book")
  canPay          Boolean  @default(false) @map("can_pay")
  canView         Boolean  @default(true) @map("can_view")
  canManageFamily Boolean  @default(false) @map("can_manage_family")
  canEmergency    Boolean  @default(false) @map("can_emergency")
  status          String   @db.VarChar(30)
  joinedAt        DateTime @db.Timestamptz(3) @map("joined_at")
  createdAt       DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([familyId, userId])
  @@map("family_members")
}

model FamilyInvitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId          String    @db.Uuid @map("family_id")
  invitedByUserId   String    @db.Uuid @map("invited_by_user_id")
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  role              String    @db.VarChar(30)
  tokenHash         String    @db.Text @map("token_hash")
  status            String    @db.VarChar(30)
  expiresAt         DateTime  @db.Timestamptz(3) @map("expires_at")
  acceptedByUserId  String?   @db.Uuid @map("accepted_by_user_id")
  acceptedAt        DateTime? @db.Timestamptz(3) @map("accepted_at")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  family       Family @relation(fields: [familyId], references: [id])
  invitedByUser User  @relation(fields: [invitedByUserId], references: [id])

  @@map("family_invitations")
}

model Beneficiary {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId              String    @db.Uuid @map("family_id")
  firstName             String    @db.VarChar(100) @map("first_name")
  lastName              String    @db.VarChar(100) @map("last_name")
  relationship          String    @db.VarChar(50)
  dateOfBirth           DateTime? @db.Date @map("date_of_birth")
  gender                String?   @db.VarChar(30)
  phone                 String?   @db.VarChar(20)
  preferredLanguage     String    @db.VarChar(10) @map("preferred_language")
  accessibilityInfo     String?   @db.Text @map("accessibility_info")
  importantNotes        String?   @db.Text @map("important_notes")
  specialInstructions  String?   @db.Text @map("special_instructions")
  status                String    @db.VarChar(30)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  deletedAt             DateTime? @db.Timestamptz(3) @map("deleted_at")

  family          Family                @relation(fields: [familyId], references: [id])
  contacts        BeneficiaryContact[]
  addresses       BeneficiaryAddress[]
  consents        BeneficiaryConsent[]
  careCards       CareCard[]
  bookings        Booking[]
  visits          Visit[]
  incidents       Incident[]
  whatsappContacts WhatsappContact[]
  voiceContacts   VoiceContact[]

  @@map("beneficiaries")
}

model BeneficiaryContact {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiaryId    String   @db.Uuid @map("beneficiary_id")
  name             String   @db.VarChar(150)
  relationship     String   @db.VarChar(50)
  phone            String   @db.VarChar(20)
  email            String?  @db.VarChar(255)
  contactType      String   @db.VarChar(30) @map("contact_type")
  priority         Int      @default(1)
  canBeContacted   Boolean  @default(true) @map("can_be_contacted")
  createdAt        DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@map("beneficiary_contacts")
}

model Address {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line1             String    @db.Text
  line2             String?   @db.Text
  landmark          String?   @db.Text
  cityId            String    @db.Uuid @map("city_id")
  postalCode        String    @db.VarChar(20) @map("postal_code")
  latitude          Float
  longitude         Float
  location          Unsupported("geography(Point,4326)")?
  accessInstructions String?  @db.Text @map("access_instructions")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  city               City                 @relation(fields: [cityId], references: [id])
  beneficiaryAddresses BeneficiaryAddress[]
  bookings           Booking[]

  @@map("addresses")
}

model BeneficiaryAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiaryId String   @db.Uuid @map("beneficiary_id")
  addressId     String   @db.Uuid @map("address_id")
  label         String   @db.VarChar(50)
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])
  address     Address     @relation(fields: [addressId], references: [id])

  @@unique([beneficiaryId, addressId])
  @@map("beneficiary_addresses")
}

model BeneficiaryConsent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiaryId String    @db.Uuid @map("beneficiary_id")
  consentType   String    @db.VarChar(50) @map("consent_type")
  status        String    @db.VarChar(30)
  givenByUserId String    @db.Uuid @map("given_by_user_id")
  consentText   String    @db.Text @map("consent_text")
  version       String    @db.VarChar(30)
  givenAt       DateTime  @db.Timestamptz(3) @map("given_at")
  revokedAt     DateTime? @db.Timestamptz(3) @map("revoked_at")

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])
  givenByUser User        @relation(fields: [givenByUserId], references: [id])

  @@map("beneficiary_consents")
}

model CareCard {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiaryId         String   @db.Uuid @map("beneficiary_id")
  preferredHospitalId   String?  @db.Uuid @map("preferred_hospital_id")
  doctorContactId       String?  @db.Uuid @map("doctor_contact_id")
  criticalInstructions  String?  @db.Text @map("critical_instructions")
  mobilityNotes         String?  @db.Text @map("mobility_notes")
  allergyInformation    String?  @db.Text @map("allergy_information")
  visibilityLevel       String   @db.VarChar(30) @map("visibility_level")
  createdAt             DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@map("care_cards")
}

model Country {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode         String   @unique @db.Char(2) @map("iso_code")
  name            String   @db.VarChar(100)
  currencyCode    String   @db.Char(3) @map("currency_code")
  timezoneDefault String   @db.VarChar(50) @map("timezone_default")
  phoneCode       String   @db.VarChar(10) @map("phone_code")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  cities City[]
  users  User[]

  @@map("countries")
}

model City {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId   String   @db.Uuid @map("country_id")
  name        String   @db.VarChar(100)
  stateName   String   @db.VarChar(100) @map("state_name")
  timezone    String   @db.VarChar(50)
  latitude    Float
  longitude   Float
  status      String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  country          Country             @relation(fields: [countryId], references: [id])
  users            User[]
  serviceAreas     ServiceArea[]
  serviceAreaCities ServiceAreaCity[]
  addresses        Address[]
  servicePricing   ServicePricing[]
  helpers          Helper[]

  @@map("cities")
}

model ServiceArea {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId    String   @db.Uuid @map("city_id")
  name      String   @db.VarChar(150)
  boundary  Unsupported("geography(Polygon,4326)")?
  status    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  city              City                 @relation(fields: [cityId], references: [id])
  serviceAreaCities ServiceAreaCity[]
  helperServiceAreas HelperServiceArea[]

  @@map("service_areas")
}

model ServiceAreaCity {
  serviceAreaId String  @db.Uuid @map("service_area_id")
  cityId        String  @db.Uuid @map("city_id")

  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id])
  city        City        @relation(fields: [cityId], references: [id])

  @@id([serviceAreaId, cityId])
  @@map("service_area_cities")
}

model ServiceCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(120)
  description  String   @db.Text
  displayOrder Int      @map("display_order")
  isActive     Boolean  @map("is_active")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId        String   @db.Uuid @map("category_id")
  name              String   @db.VarChar(150)
  slug              String   @unique @db.VarChar(180)
  shortDescription  String   @db.Text @map("short_description")
  description       String   @db.Text
  baseDurationMin   Int      @map("base_duration_min")
  maxDurationMin    Int?     @map("max_duration_min")
  basePrice         Decimal  @db.Decimal(12, 2) @map("base_price")
  currency          String   @db.Char(3)
  status            String   @db.VarChar(30)
  createdAt         DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  category       ServiceCategory   @relation(fields: [categoryId], references: [id])
  pricing        ServicePricing[]
  requirements   ServiceRequirement[]
  checklists     ServiceChecklist[]
  policies       ServicePolicy[]
  helperServices HelperService[]
  bookings       Booking[]

  @@map("services")
}

model ServicePricing {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId     String    @db.Uuid @map("service_id")
  cityId        String    @db.Uuid @map("city_id")
  basePrice     Decimal   @db.Decimal(12, 2) @map("base_price")
  perHourPrice  Decimal?  @db.Decimal(12, 2) @map("per_hour_price")
  perKmPrice    Decimal?  @db.Decimal(12, 2) @map("per_km_price")
  urgencyFee    Decimal   @default(0) @db.Decimal(12, 2) @map("urgency_fee")
  peakFee       Decimal   @default(0) @db.Decimal(12, 2) @map("peak_fee")
  helperPayout  Decimal   @db.Decimal(12, 2) @map("helper_payout")
  taxPercent    Decimal   @db.Decimal(5, 2) @map("tax_percent")
  effectiveFrom DateTime  @db.Timestamptz(3) @map("effective_from")
  effectiveTo   DateTime? @db.Timestamptz(3) @map("effective_to")
  isActive      Boolean   @map("is_active")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])

  @@map("service_pricing")
}

model ServiceRequirement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId        String   @db.Uuid @map("service_id")
  requirementType  String   @db.VarChar(50) @map("requirement_type")
  requirementValue String   @db.Text @map("requirement_value")
  isMandatory      Boolean  @map("is_mandatory")
  createdAt        DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id])

  @@map("service_requirements")
}

model ServiceChecklist {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String   @db.Uuid @map("service_id")
  title        String   @db.VarChar(200)
  description  String   @db.Text
  isRequired   Boolean  @map("is_required")
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  service        Service         @relation(fields: [serviceId], references: [id])
  taskChecklists TaskChecklist[]

  @@map("service_checklists")
}

model ServicePolicy {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String   @db.Uuid @map("service_id")
  cancellationPolicy Json    @map("cancellation_policy")
  safetyRules       Json     @map("safety_rules")
  evidenceRules     Json     @map("evidence_rules")
  notificationRules Json     @map("notification_rules")
  allowedActions    Json     @map("allowed_actions")
  prohibitedActions Json     @map("prohibited_actions")
  createdAt         DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id])

  @@map("service_policies")
}

model Helper {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @db.Uuid @map("user_id")
  firstName         String    @db.VarChar(100) @map("first_name")
  lastName          String    @db.VarChar(100) @map("last_name")
  dateOfBirth       DateTime  @db.Date @map("date_of_birth")
  gender            String    @db.VarChar(30)
  bio               String    @db.Text
  experienceYears   Decimal   @db.Decimal(4, 1) @map("experience_years")
  primaryCityId     String    @db.Uuid @map("primary_city_id")
  currentLocation   Unsupported("geography(Point,4326)")? @map("current_location")
  locationUpdatedAt DateTime? @db.Timestamptz(3) @map("location_updated_at")
  status            String    @db.VarChar(30)
  ratingAverage     Decimal   @default(0) @db.Decimal(3, 2) @map("rating_average")
  ratingCount       Int       @default(0) @map("rating_count")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id])
  primaryCity        City                 @relation(fields: [primaryCityId], references: [id])
  serviceAreas       HelperServiceArea[]
  services           HelperService[]
  availability       HelperAvailability[]
  documents          HelperDocument[]
  verifications      HelperVerification[]
  referenceChecks    HelperReference[]
  training           HelperTraining[]
  bankAccounts       HelperBankAccount[]
  statusHistory      HelperStatusHistory[]
  reliability        HelperReliability?
  taskAssignments    TaskAssignment[]     @relation("TaskAssignment")
  taskOffers         TaskOffer[]          @relation("TaskOffer")
  taskLocations      TaskLocation[]       @relation("TaskLocation")
  earnings           HelperEarning[]      @relation("HelperEarning")
  visits             Visit[]
  payouts            HelperPayout[]
  incidents          Incident[]
  ratings            Rating[]
  helperBlocks       HelperBlock[]
  preferredIn        PreferredHelper[]
  financialTransactions FinancialTransaction[]

  @@map("helpers")
}

model HelperServiceArea {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  helperId      String   @db.Uuid @map("helper_id")
  serviceAreaId String   @db.Uuid @map("service_area_id")
  isPrimary     Boolean  @map("is_primary")
  createdAt     DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  helper      Helper      @relation(fields: [helperId], references: [id])
  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id])

  @@unique([helperId, serviceAreaId])
  @@map("helper_service_areas")
}

model HelperService {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  helperId           String    @db.Uuid @map("helper_id")
